# ==============================================================================
# AI Resume Screening Platform - Cloud Environment Configuration
# Copy this file to .env and configure with your Azure resource credentials.
# If values are left blank, the application automatically falls back to local mode.
# ==============================================================================

# Flask Settings
SECRET_KEY=your-secure-production-secret-key-change-this
FLASK_DEBUG=False
PORT=5000

# ------------------------------------------------------------------------------
# Stage 1: Azure SQL Database Configuration
# ------------------------------------------------------------------------------
# Option A: Full connection string
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=resume_screening_db;Uid=cloudadmin;Pwd=YourStrongPassword!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Option B: Individual connection parameters
# AZURE_SQL_SERVER=your-server.database.windows.net
# AZURE_SQL_DATABASE=resume_screening_db
# AZURE_SQL_USER=cloudadmin
# AZURE_SQL_PASSWORD=YourStrongPassword!
# AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}

# ------------------------------------------------------------------------------
# Stage 2: Azure Blob Storage Configuration
# ------------------------------------------------------------------------------
# Option A: Storage Account Connection String
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourAccountKey==;EndpointSuffix=core.windows.net"

# Option B: Storage Account Name (uses DefaultAzureCredential / Managed Identity)
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_CONTAINER=resumes

# ------------------------------------------------------------------------------
# Stage 3: Azure Functions Configuration
# ------------------------------------------------------------------------------
# URL of your deployed Azure Function app
AZURE_FUNCTION_URL=https://func-ai-resume-screener.azurewebsites.net/api/screen_resume
AZURE_FUNCTION_KEY=yourFunctionKeyIfRequired

# ------------------------------------------------------------------------------
# Stage 4: Azure OpenAI / AI Services (Semantic Matching Engine)
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=yourAzureOpenAIAPIKey12345
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

